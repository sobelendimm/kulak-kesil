# Kulak Kesil (oto-eq): 5 virtual outputs (oto_eq_cs2/oyun/muzik/film + oto_eq_duz).
# A separate `pipewire -c` process (modelled on filter-chain.service).
# The config file is generated by `kulak eq-uret`.
[Unit]
Description=Kulak Kesil - virtual EQ outputs (PipeWire filter-chain)
Documentation=https://github.com/sobelendimm/kulak-kesil
After=pipewire.service pipewire-session-manager.service
# Stops/restarts together with PipeWire.
BindsTo=pipewire.service
# When the router (oto-eq.service) stops or fails for good, the EQ outputs close too;
# streams then fall back to the default output by themselves (never silent).
# DELIBERATELY no After=oto-eq.service: the router starts AFTER this one
# (After=oto-eq-sinks.service there, no cycle), and when both stop the router
# stops FIRST (moving streams back to the default output), then this one.
BindsTo=oto-eq.service
ConditionPathExists=%h/.config/oto-eq/oto-eq-sinks.conf

[Service]
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
Type=simple
ExecStart=/usr/bin/pipewire -c %h/.config/oto-eq/oto-eq-sinks.conf
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
# pipewire.service starts this every time it starts (login, after a crash/restart).
WantedBy=pipewire.service
