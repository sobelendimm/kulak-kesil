# Kulak Kesil (oto-eq): processed virtual microphone "Kulak Kesil · Mikrofon" (oto_eq_mikrofon).
# A separate `pipewire -c` process; the config file is generated by `python3 -m oto_eq.micgen generate`.
# Installing does NOT change the default microphone (the window / `kulak mikrofon varsayilan` does).
[Unit]
Description=Kulak Kesil - processed virtual microphone
Documentation=https://github.com/sobelendimm/kulak-kesil
After=pipewire.service pipewire-pulse.service
# Stops/restarts together with PipeWire.
BindsTo=pipewire.service
ConditionPathExists=%h/.config/oto-eq/mikrofon.conf

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c %h/.config/oto-eq/mikrofon.conf
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=pipewire.service
