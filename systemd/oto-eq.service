# Kulak Kesil (oto-eq): moves each audio stream to the EQ output that fits it.
# install.sh installs a copy into the systemd user directory; when the source or the
# config folder is not at the default path it fills in the real paths there.
[Unit]
Description=Kulak Kesil - automatic EQ router
Documentation=https://github.com/sobelendimm/kulak-kesil
After=pipewire-pulse.service oto-eq-sinks.service wireplumber.service
Wants=pipewire-pulse.service oto-eq-sinks.service

[Service]
Type=simple
WorkingDirectory=%h/.local/src/oto-eq
Environment=PYTHONPATH=%h/.local/src/oto-eq
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m oto_eq.router
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
Slice=session.slice

[Install]
# Starts at login. If PipeWire restarts the service keeps running
# (the pactl event listener reconnects by itself).
WantedBy=default.target
